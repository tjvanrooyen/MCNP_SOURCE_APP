						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">By using these functions in work, improved values of:</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">* Standard isotopic masses<br/>* Standard elemental masses<br/>* Halflives of radionuclides<br/>will automatically filter through all worksheets, when the updated values are put in the appropriate reference tables.<sp count="2"/>
						</p>
					</text>
				</region>
				<region region-id="731" left="0" top="2052" width="6000" height="6" align-x="0" align-y="2052" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<pageBreak/>
				</region>
				<region region-id="764" left="6" top="2070" width="815.25" height="23.25" align-x="6" align-y="2088" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Heading 3" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Clearance levels for disposal of bulk quantities of radioactive material (IAEA BSS 2014):<sp count="4"/>
						</p>
					</text>
				</region>
				<region region-id="765" left="6" top="2106.75" width="243" height="36" align-x="140.25" align-y="2130" show-border="true" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:id xml:space="preserve" subscript="ZAI">CL</ml:id>
								<ml:sequence>
									<ml:real>27</ml:real>
									<ml:real>60</ml:real>
									<ml:real>0</ml:real>
								</ml:sequence>
							</ml:apply>
							<ml:unitOverride>
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve">Bq</ml:id>
									<ml:apply>
										<ml:pow/>
										<ml:id xml:space="preserve">gm</ml:id>
										<ml:real>-1</ml:real>
									</ml:apply>
								</ml:apply>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>0.1</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="becquerel"/>
										<unitReference unit="gram" power-numerator="-1"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="766" left="6" top="2160.75" width="228.75" height="36" align-x="126" align-y="2184" show-border="true" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
