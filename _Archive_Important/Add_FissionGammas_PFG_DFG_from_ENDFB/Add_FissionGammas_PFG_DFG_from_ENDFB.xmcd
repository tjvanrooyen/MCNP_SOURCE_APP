						<p style="Heading 3" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Time-to-clearance</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<region region-id="360" left="6" top="909" width="36" height="15" align-x="18.75" align-y="918" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#80ff80" tag="">
								<math optimize="false" disable-calc="false">
