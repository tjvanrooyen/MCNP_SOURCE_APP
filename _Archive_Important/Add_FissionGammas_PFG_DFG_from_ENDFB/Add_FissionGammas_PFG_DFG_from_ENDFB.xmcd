						<p style="Heading 3" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">RS = Radiological Sentencing (verdict):</p>
					</text>
				</region>
				<region region-id="811" left="6" top="2708.25" width="445.5" height="21.75" align-x="204" align-y="2724" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
