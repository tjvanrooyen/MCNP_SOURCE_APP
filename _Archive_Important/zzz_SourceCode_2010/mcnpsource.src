module KINDS
!-----------------------------------------------------------------------------------------------------------------------------------
!
! Selects the KIND for REAL data (compiler dependent)
!
! Revision record:
!-----------------------------------------------------------------------------------------------------------------------------------
! No.   Date          Programmer     Description of changes
!-----------------------------------------------------------------------------------------------------------------------------------
! 0     2002/07/15    E Z Muller     Original
!
  implicit none
  public
! for IEEE 754, Intel, Lahey
!  integer ,parameter :: sp = selected_real_kind(p = 6 ,r = 37)  ! IEEE 754 single-precision
!  integer ,parameter :: dp = selected_real_kind(p = 15,r = 307) ! IEEE 754 double-precision
  integer ,parameter :: sp = selected_real_kind(p = 6 ,r = 37)            ! single-precision KIND
  integer ,parameter :: dp = selected_real_kind(p = 13,r = 200)           ! double-precision KIND
  integer, parameter :: qp = MAX(dp, selected_real_kind(p = 26,r = 300))  ! quadruple-precision kind
! pseudonyms
  integer, parameter :: singel    = sp  ! single-precision
  integer, parameter :: doubel    = dp  ! double-precision
  integer, parameter :: quadrupel = qp  ! quadruple-precision
  integer, parameter :: reals     = sp  ! standard precision
  integer, parameter :: high_p    = dp  ! high precision
!
contains
  subroutine test_kinds
    real(KIND=sp) :: ps=0.0_sp
    real(KIND=dp) :: pd=0.0_dp
    real(KIND=qp) :: pq=0.0_qp
    write(*,'(" sp has precision",i3," and range",i5)') precision(ps), range(ps)
    write(*,'(" sp has machine epsilon",es14.6)') epsilon(ps)
    write(*,'(" dp has precision",i3," and range",i5)') precision(pd), range(pd)
    write(*,'(" dp has machine epsilon",es14.6)') epsilon(pd)
    write(*,'(" qp has precision",i3," and range",i5)') precision(pq), range(pq)
    write(*,'(" qp has machine epsilon",es14.6)') epsilon(pq)
  end subroutine test_kinds
end module KINDS
#FEND: m_KINDS.f90
#FBEG: FileHandleMod.f90
Module FileHandle

! Module for central control of file opening / closing / error control and unit number control

IMPLICIT NONE

PRIVATE
PUBLIC                                          :: OpenFile, CloseFile


integer        :: initial_Unit = 200       ! starting unit number for file control
integer        :: fileCount = 0            ! number of files in unit
integer        :: internal_unit=199
integer        :: unitlimit=10000



!---------------------------------------------------------------------------
CONTAINS



!--------------------------------------------------------------------
Function OpenFile (FileName, FileStatus,FileAction)
! Subroutine for generic file opening and unit number allocation
!--------------------------------------------------------------------
character (*), INTENT (IN)     :: FileName              ! name of file to open
character (*), INTENT (IN)     :: FileStatus,FileAction ! Flags for file-open status/action
integer                        :: ierror,i                ! status flag for file opening
integer                        :: OpenFile,cur          ! File Unit to return
LOGICAL                        :: legal,used
character(len=80)              :: fln


   if (fileCount.eq.0) then
      OPEN (UNIT=internal_unit, FILE='filelog.txt', STATUS='REPLACE', ACTION='WRITE',IOSTAT=ierror)
   end if
   do i=initial_Unit-1,unitlimit
     inquire(UNIT=i,EXIST=legal,NAME=fln,OPENED=used)
     if (legal .and. .not. used) then
      cur=i
      exit
!     else
!       write(internal_unit,*) 'Unit ',i,' not available - used by ',fln

     end if
   end do
   !Attempt to open the target file
   OPEN (UNIT=cur, FILE=trim(adjustl(FileName)), STATUS=trim(adjustl(FileStatus)), ACTION=trim(adjustl(FileAction)),IOSTAT=ierror)
   if (ierror.eq.0) then

      OpenFile=cur
      fileCount=fileCount+1
      write(internal_unit,*) 'File ',trim(adjustl(FileName)),' opened on unit ',cur
   else
      write (*,*) 'Error opening file ',trim(adjustl(FileName)),' on unit ',initial_Unit+fileCount,' :',ierror
      OpenFile=-1
   end if



End FUNCTION OpenFile


!--------------------------------------------------------------
Subroutine CloseFile(UnitNumber)
! Generic Routine to close file on a given unit number
!--------------------------------------------------------------
integer,INTENT(IN)                 :: UnitNumber           ! Unit Number of file to close

   write(internal_unit,*) 'File closed on unit ',UnitNumber

close (unitnumber)

End Subroutine CloseFile


!--------------------------------------------------------------------------------------------
END Module FileHandle
#FEND: FileHandleMod.f90
#FBEG: mcnpsource.f90
Program mcnpsource
! Program to read source term definition from library and generate MCNP SDEF input
!-------------------------------------------------------

USE FileHandle         ! Generic File handling routines

IMPLICIT NONE

!Revision Record:
!----------------------------------
!  1.)   Creation of basic structure              - 12 / 11 / 13       - Rian Prinsloo

character(len=255)                        :: inputfilename,tempstring                ! inputfile for nodal code
integer                                   :: unit_main_dump,error                    ! main debug file
character(len=10)                         :: rundate,runtime                         ! date and time of parametrization calculation
integer                                   :: nr
real                                      :: time,time2

   unit_main_dump = openFile('DUMP_main.txt','REPLACE','WRITE')
   CALL DATE_AND_TIME (rundate,runtime)                            ! Get date and time of program run
   runtime = runtime(1:2)//':'//runtime(3:4)//':'//runtime(5:6)    ! Process runtime
   call GETARG(1,inputfilename)
   call readInput(inputfilename,error)
   write (unit_main_dump,*) 'Commencing processing '//TRIM(runtime)//' '//rundate(1:8)
   write (*,*) 'Commencing calculation '//TRIM(runtime)//' '//rundate(1:8)

   if (error == 0) then


      write(unit_main_dump,*) 'Input file processed.'

      CALL CPU_TIME(time)
!      call dostuff
      call CPU_TIME(time2)

   else
      write(unit_main_dump,*) 'ERROR reading input file.'
      write(*,*) 'ERROR reading input file.'
   end if

   CALL DATE_AND_TIME (rundate,runtime)                            ! Get date and time of program run
   runtime = runtime(1:2)//':'//runtime(3:4)//':'//runtime(5:6)    ! Process runtime
   write (unit_main_dump,*) 'Processing finished at '//TRIM(runtime)//' '//rundate(1:8)
   write (*,*) 'Calculation finished at '//TRIM(runtime)//' '//rundate(1:8)
   write(*,*) 'Calculational time: ',time2-time
   write(unit_main_dump,*) 'Calculational time: ',time2-time

CONTAINS


!----------------------------------------------------------------------
Subroutine readInput(   &
inputfilename,error)

!Subroutine to read the Generic input card
!----------------------------------------------------------------------
character(len=*),INTENT(IN)               :: inputfilename
integer, intent(OUT                       :: error


End Subroutine readInput


End Program mcnpsource
#FEND: mcnpsource.f90
